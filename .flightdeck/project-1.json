{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightdeck.dmarz.xyz/schemas/project-1.json",
  "title": "Flight Deck project metadata, v1 (project.yaml); 1.1 adds license/authors/identifier/date_published/relations + template.commit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "id",
    "name"
  ],
  "properties": {
    "project": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "summary": {
      "type": "string",
      "maxLength": 200
    },
    "status": {
      "type": "string",
      "enum": [
        "idea",
        "active",
        "paused",
        "done",
        "archived"
      ]
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "public"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
      },
      "maxItems": 16,
      "uniqueItems": true
    },
    "owner": {
      "type": "string"
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "description": "SPDX identifier (MIT, Apache-2.0, CC-BY-4.0 …), `proprietary`, or a URL; required by every export (RO-Crate, codemeta, CFF)"
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "orcid": {
            "type": "string",
            "pattern": "^https://orcid\\.org/\\d{4}-\\d{4}-\\d{4}-\\d{3}[0-9X]$"
          },
          "email": {
            "type": "string",
            "pattern": "^[^@\\s]+@[^@\\s]+$"
          },
          "url": {
            "type": "string",
            "pattern": "^https?://\\S+$"
          }
        },
        "patternProperties": {
          "^x-": {
            "description": "open namespace for experiments; checkers ignore it"
          }
        }
      },
      "description": "who made it, for citation (CFF authors, RO-Crate author, codemeta author); ORCID as the person's @id when present"
    },
    "identifier": {
      "type": "string",
      "pattern": "^(https?://\\S+|doi:10\\.\\S+|10\\.\\d{4,}/\\S+)$",
      "description": "a DOI or URL that names this project (DataCite Identifier, RO-Crate root @id, CFF doi)"
    },
    "date_published": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "when it was first published; RO-Crate datePublished falls back to `created`"
    },
    "relations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "ref"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "depends_on",
              "part_of",
              "derived_from",
              "supersedes",
              "related"
            ]
          },
          "ref": {
            "type": "string",
            "pattern": "^(project|artifact):[a-z0-9._/-]+$",
            "description": "entity ref: project:<id> or artifact:<project id>/<artifact id>"
          },
          "note": {
            "type": "string",
            "maxLength": 200
          }
        },
        "patternProperties": {
          "^x-": {
            "description": "open namespace for experiments; checkers ignore it"
          }
        }
      },
      "description": "typed links to other projects/artifacts (Backstage-style entity refs); the hub materialises the reverse direction"
    },
    "agent_branches": {
      "type": "boolean",
      "default": false,
      "description": "P2: sessions launched into this project get their own worktree + branch agent/<cc|cx|nx>/<machine>-<id6>/<slug>; Flight Deck autosaves, pushes (private repos only) and opens draft PRs. Off unless true; a launch may override with `branch`"
    },
    "hue": {
      "type": "integer",
      "minimum": 0,
      "maximum": 359
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        },
        "live": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        },
        "docs": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        },
        "tracker": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        }
      },
      "patternProperties": {
        "^x-": {
          "description": "open namespace for experiments; checkers ignore it"
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "description": "where things live, relative to the project root; the defaults are src/, artifacts/, data/, notes/",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[^/~][^\\n]*$"
        },
        "artifacts": {
          "type": "string",
          "pattern": "^[^/~][^\\n]*$"
        },
        "data": {
          "type": "string",
          "pattern": "^[^/~][^\\n]*$"
        },
        "notes": {
          "type": "string",
          "pattern": "^[^/~][^\\n]*$"
        }
      },
      "patternProperties": {
        "^x-": {
          "description": "open namespace for experiments; checkers ignore it"
        }
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "description": "defaults the launch sheet pre-fills when a session is started from the registry",
      "properties": {
        "harness": {
          "type": "string",
          "enum": [
            "claude",
            "codex",
            "nanocodex",
            "hermes"
          ]
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "folder": {
          "type": "string",
          "pattern": "^[^/~][^\\n]*$"
        },
        "prompt": {
          "type": "string",
          "maxLength": 2000
        },
        "deck": {
          "type": "string"
        },
        "setup": {
          "type": "string",
          "description": "R13: shell run once in a NEW agent worktree before the agent starts (idempotent; ≤ 20 min by convention); gets FD_SESSION FD_PROJECT FD_WORKSPACE FD_PORT"
        },
        "resume": {
          "type": "string",
          "description": "R13: shell run before a session attaches to an EXISTING workspace (idempotent; ≤ 10 s)"
        },
        "archive": {
          "type": "string",
          "description": "R13: shell run in the worktree before /merge or /discard removes it"
        },
        "ports": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "R13: size of the workspace's port block; FD_PORT is its first port (default 10)"
        }
      },
      "patternProperties": {
        "^x-": {
          "description": "open namespace for experiments; checkers ignore it"
        }
      }
    },
    "formats": {
      "type": "object",
      "description": "what generated outputs must look like, by artifact type; `fd check --strict` probes every path-backed artifact of that type",
      "propertyNames": {
        "enum": [
          "figure",
          "film",
          "doc",
          "paper",
          "deck",
          "dataset",
          "post",
          "thread",
          "spec",
          "model",
          "notebook"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ext": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+$"
            },
            "minItems": 1
          },
          "min_width": {
            "type": "integer",
            "minimum": 1
          },
          "max_width": {
            "type": "integer",
            "minimum": 1
          },
          "min_height": {
            "type": "integer",
            "minimum": 1
          },
          "max_height": {
            "type": "integer",
            "minimum": 1
          },
          "aspect": {
            "type": "string",
            "pattern": "^\\d+:\\d+$"
          },
          "video": {
            "type": "string",
            "enum": [
              "h264",
              "hevc",
              "av1",
              "vp9"
            ]
          },
          "audio": {
            "type": "string",
            "enum": [
              "aac",
              "opus",
              "none"
            ]
          },
          "faststart": {
            "type": "boolean"
          },
          "max_fps": {
            "type": "number",
            "minimum": 1
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "max_duration_s": {
            "type": "number",
            "minimum": 0
          },
          "background": {
            "type": "string",
            "enum": [
              "dark",
              "light",
              "transparent"
            ]
          },
          "dpi": {
            "type": "integer",
            "minimum": 36
          },
          "name": {
            "type": "string",
            "description": "filename pattern the version must match; default `<id>-v<N>.<ext>`"
          }
        },
        "patternProperties": {
          "^x-": {
            "description": "open namespace for experiments; checkers ignore it"
          }
        }
      }
    },
    "serving": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mirror": {
          "type": "boolean",
          "description": "mirror path-backed artifacts to the hub (default true)"
        },
        "cdn": {
          "description": "true: publish artifacts marked public (project visibility public) to the public CDN bucket; \"private\": every path-backed version goes to the private bucket (HUB_CDN_PRIVATE_BUCKET) and is served by short-lived presigned URLs; false/absent: stays on the box, unless the hub runs with HUB_CDN_DEFAULT=private, where it means private too; \"off\": never leaves the box",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "enum": [
                "private",
                "off"
              ]
            }
          ]
        },
        "renditions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "720",
              "480",
              "poster"
            ]
          }
        }
      },
      "patternProperties": {
        "^x-": {
          "description": "open namespace for experiments; checkers ignore it"
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "description": "the scaffold this project came from, so `fd upgrade` can re-apply it",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$",
          "description": "the agent-status commit the template was taken from; `fd upgrade` 3-way merges from it (Copier's _commit)"
        }
      },
      "patternProperties": {
        "^x-": {
          "description": "open namespace for experiments; checkers ignore it"
        }
      }
    },
    "requires": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "minimum fd format that can read this file (written by fd when it uses keys newer than 1.0); an older checker stops with `run fd upgrade` instead of reporting unknown keys"
    }
  },
  "patternProperties": {
    "^x-": {
      "description": "open namespace for experiments; checkers ignore it"
    }
  }
}
