  {
    "id": "capacity-base",
    "root": "capacity",
    "variant": "base",
    "public": {
      "task": {
        "kind": "capacity",
        "instruction": "Apply the current policy to the facts. Return answer or insufficient_evidence with the relevant document IDs."
      },
      "documents": [
        {
          "id": "policy",
          "kind": "policy",
          "version": 1,
          "body": "Use the newest signed capacity report at or before decision_day. Unsigned reports are advisory. Reserve quantity only if available >= quantity; otherwise wait."
        },
        {
          "id": "facts",
          "kind": "facts",
          "version": 1,
          "body": {
            "decision_day": 3,
            "quantity": 6,
            "reports": [
