  {
    "id": "temperature-base",
    "root": "temperature",
    "variant": "base",
    "public": {
      "task": {
        "kind": "temperature",
        "instruction": "Apply the current policy to the facts. Return answer or insufficient_evidence with the relevant document IDs."
      },
      "documents": [
        {
          "id": "policy",
          "kind": "policy",
          "version": 1,
          "body": "Hold batch if any reading is above 8 Celsius. Convert Fahrenheit using (F - 32) * 5 / 9. Equality does not trigger hold."
        },
        {
          "id": "facts",
          "kind": "facts",
          "version": 1,
          "body": {
            "readings": [
              {
                "value": "46.4",
                "unit": "F"
              },
              {
                "value": "7.9",
                "unit": "C"
              }
            ]
          }
        }
      ]
    }
  },
