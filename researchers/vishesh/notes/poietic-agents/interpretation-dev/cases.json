                "day": 1,
                "signed": true,
                "available": 12
              },
              {
                "day": 3,
                "signed": false,
                "available": 100
              },
              {
                "day": 2,
                "signed": true,
                "available": 5
              }
            ]
          }
        }
      ]
    }
  },
