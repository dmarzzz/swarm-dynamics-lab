          "id": "policy",
          "kind": "policy",
          "version": 1,
          "body": "Refund if days_since_delivery <= 14 and opened is false. Damaged items qualify regardless of opened status, but the day limit still applies."
        },
        {
          "id": "facts",
          "kind": "facts",
          "version": 1,
          "body": {
            "days_since_delivery": 16,
            "opened": true,
            "damaged": true
          }
        }
      ]
    }
  },
