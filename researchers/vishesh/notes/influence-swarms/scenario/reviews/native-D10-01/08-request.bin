.35 minimum. No candidate meets all mandatory requirements simultaneously.\"}], \"checks\": [{\"request\": {\"candidate\": \"Aster\", \"kind\": \"contract\"}, \"document\": {\"id\": \"quote-0\", \"title\": \"Aster deployment quote\", \"kind\": \"contract\", \"publisher\": \"Aster-commercial\", \"revision\": \"2026-10-04-demo\", \"text\": \"Aster: $28 per seat per month for 12 months; $0.11 per automated resolution, no free allowance; one-time setup $3600. A resolution avoids one human-handled ticket in this planning model. SSO included: True; complete export: False. No other discounts are committed.\"}, \"interpretation\": {\"claim\": \"Aster quotes $28/seat/month for 12 months plus $3,600 setup fee, with $0.11 per automated resolution and no free allowance; SSO included but complete export excluded.\", \"citation\": \"quote-0\", \"limitation\": \"This is a single quote from one vendor dated 2026-10-04-demo; actual costs depend on seat count, resolution volume, and contract negotiation; no approval status indicated.\"}}, {\"request\": {\"candidate\": \"Birch\", \"kind\": \"contract\"}, \"document\": {\"id\": \"quote-1\", \"title\": \"Birch deployment quote\", \"kind\": \"contract\", \"publisher\": \"Birch-commercial\", \"revision\": \"2026-10-04-demo\", \"text\": \"Birch: $84 per seat per month for 12 months; $0.2 per automated resolution, no free allowance; one-time setup $9000. A resolution avoids one human-handled ticket in this planning model. SSO included: True; complete export: True. No other discounts are committed.\"}, \"interpretation\": {\"claim\": \"Birch quotes $84/seat/month for 12 months plus $9000 setup, with $0.2 per automated resolution and no free allowance. SSO and complete export included.\", \"citation\": \"quote-1\", \"limitation\": \"Quote is from October 2026 demo revision; actual costs depend on seat count, resolution volume, and contract terms not fully detailed here.\"}}], \"cost_worksheet\": [{\"candidate\": \"Aster\", \"automation_rate\"