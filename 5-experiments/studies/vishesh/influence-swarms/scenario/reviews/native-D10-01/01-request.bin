ction benchmarks.\"}], \"checks\": [{\"request\": {\"candidate\": \"Cobalt\", \"kind\": \"contract\"}, \"document\": {\"id\": \"quote-2\", \"title\": \"Cobalt deployment quote\", \"kind\": \"contract\", \"publisher\": \"Cobalt-commercial\", \"revision\": \"2026-10-04-demo\", \"text\": \"Cobalt: $20 per seat per month for 12 months; $0.03 per automated resolution, no free allowance; one-time setup $2150. A resolution avoids one human-handled ticket in this planning model. SSO included: True; complete export: True. No other discounts are committed.\"}, \"interpretation\": {\"claim\": \"Cobalt deployment costs $20/seat/month for 12 months plus $0.03 per automated resolution and $2150 one-time setup, with SSO and complete export included.\", \"citation\": \"quote-2\", \"limitation\": \"Quote does not specify number of seats, expected resolution volume, or contract terms beyond pricing. No approval status documented. Actual costs depend on deployment scale.\"}}, {\"request\": {\"candidate\": \"Aster\", \"kind\": \"scope\"}, \"document\": {\"id\": \"scope-0\", \"title\": \"Aster deployment scope\", \"kind\": \"deployment\", \"publisher\": \"Aster-security\", \"revision\": \"2026-10-04-demo\", \"text\": \"Aster: ticket storage region EU; inference processing region UNCONFIRMED. This deployment-specific response supersedes the general 'EU hosting available' brochure. Unknown is not approval; requirement is buyer policy, not a legal conclusion.\"}, \"interpretation\": {\"claim\": \"Aster deployment specifies ticket storage in EU region, but inference processing region is unconfirmed. This deployment-specific scope supersedes general EU hosting claims in marketing materials.\", \"citation\": \"scope-0\", \"limitation\": \"Document explicitly states unknown status is not approval. Inference processing location remains unverified. Requirement reflects buyer policy rather than legal determination. No final recommendation provided.\"}}], \"cost_worksheet\": [{\"candidate\": \"Ast