{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "event",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "type": "string"
    },
    "study_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "scenario_id": {
      "type": "string"
    },
    "replicate": {
      "type": "integer",
      "minimum": 0
    },
    "condition": {
      "type": "string"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "type": {
      "type": "string",
      "enum": [
        "run_start",
        "observation",
        "decision",
        "evaluation",
        "run_end"
      ]
    },
    "agent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_seq": {
      "type": [
        "integer",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    },
    "prev_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "event_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "study_id",
    "run_id",
    "scenario_id",
    "replicate",
    "condition",
    "seq",
    "type",
    "agent_id",
    "parent_seq",
    "payload",
    "prev_hash",
    "event_hash"
  ],
  "additionalProperties": false
}
