# Copy to .env (gitignored).
AGENTOPS_ME=yourhandle              # matches people/<handle>.yml
DIGITALOCEAN_TOKEN=                 # your own DO token, only needed for `task up`
SOPS_AGE_KEY_FILE=./keys.txt        # your age private key, for secrets/
AGENTOPS_SSH_KEY=                   # optional: key for fleet ssh (e.g. ~/.ssh/fleet_ed25519); default = ssh picks
