{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": "python3 .flightdeck/hooks/session-context.py --cursor", "timeout": 10 }
    ],
    "preToolUse": [
      { "command": "python3 .flightdeck/hooks/guard-artifacts.py --cursor", "timeout": 10 }
    ],
    "beforeShellExecution": [
      { "command": "python3 .flightdeck/hooks/guard-artifacts.py --cursor", "timeout": 10 }
    ],
    "stop": [
      { "command": "python3 .flightdeck/hooks/check-on-stop.py --cursor", "timeout": 60, "loop_limit": 1 }
    ]
  }
}
